 {
  "function": {
   "description": "Search file contents with ripgrep regex.",
   "name": "Grep",
   "parameters": {
    "properties": {
     "after": {
      "description": "Lines of context after each match",
      "type": "integer"
     },
     "before": {
      "description": "Lines of context before each match",
      "type": "integer"
     },
     "context": {
      "description": "Lines of context around each match",
      "type": "integer"
     },
     "glob": {
      "description": "Filter, e.g. *.py",
      "type": "string"
     },
     "head_limit": {
      "description": "Max lines returned (default 250)",
      "type": "integer"
     },
     "ignore_case": {
      "description": "Case insensitive",
      "type": "boolean"
     },
     "line_numbers": {
      "description": "Show line numbers (content mode, default true)",
      "type": "boolean"
     },
     "multiline": {
      "description": "Let patterns span lines",
      "type": "boolean"
     },
     "offset": {
      "description": "Skip this many result lines first",
      "type": "integer"
     },
     "output_mode": {
      "description": "Default content (matching lines)",
      "enum": [
       "content",
       "files_with_matches",
       "count"
      ],
      "type": "string"
     },
     "path": {
      "type": "string"
     },
     "pattern": {
      "type": "string"
     },
     "type": {
      "description": "ripgrep file type, e.g. py, js",
      "type": "string"
     }
    },
    "required": [
     "pattern"
    ],
    "type": "object"
   }
  },
  "type": "function"
 },
 {
